<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="RockBlack"
    Width="1040"
    Height="760"
    MinWidth="420"
    MinHeight="600"
    x:TypeArguments="vms:MainWindowViewModel"
    Background="{DynamicResource RB.BgGradient}"
    Icon="/Resources/v2rayN.ico"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="MenuIcon" TargetType="{x:Type materialDesign:PackIcon}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource RB.TextMuted}" />
        </Style>
    </Window.Resources>

    <!--  RockBlack UI 3.0 (branding/DESIGN.md): top bar (settings / wordmark / add) + HomeView  -->
    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        DialogBackground="{DynamicResource RB.Surface}"
        DialogContentUniformCornerRadius="18"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ===== Top bar  =====  -->
            <Grid Grid.Row="0" Margin="14,12,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  settings: every upstream window / action  -->
                <Grid Grid.Column="0">
                    <Button
                        x:Name="btnSettings"
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="{x:Static resx:ResUI.RbSettings}"
                        Style="{StaticResource RB.GhostButton}"
                        ToolTip="{x:Static resx:ResUI.RbSettings}">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Kind="Cog" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="menuSettings" Style="{StaticResource DefContextMenu}">
                                <MenuItem
                                    x:Name="menuOptionSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuOptionSetting}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="CogOutline" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuRoutingSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuRoutingSetting}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="CallSplit" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuDNSSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuDNSSetting}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Dns" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuFullConfigTemplate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuFullConfigTemplate}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="CodeJson" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuSubSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubSetting}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="RssBox" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.menuSubscription}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Sync" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                    <MenuItem
                                        x:Name="menuSubUpdate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                    <MenuItem
                                        x:Name="menuSubUpdateViaProxy"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                    <MenuItem
                                        x:Name="menuSubGroupUpdate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                    <MenuItem
                                        x:Name="menuSubGroupUpdateViaProxy"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuGlobalHotkeySetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="KeyboardOutline" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    x:Name="menuAdvancedServers"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.RbAdvancedServers}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="TableLarge" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuLogs"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.RbLogs}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="TextBoxOutline" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    x:Name="menuTheme"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.TbSettingsTheme}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="PaletteOutline" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="EarthBox" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                    <MenuItem
                                        x:Name="menuRegionalPresetsDefault"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsRussia"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsIran"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuBackupAndRestore"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuBackupAndRestore}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="BackupRestore" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.RbMore}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="DotsHorizontal" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                    <MenuItem
                                        x:Name="menuReload"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuReload}"
                                        InputGestureText="F5" />
                                    <MenuItem
                                        x:Name="menuRebootAsAdmin"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRebootAsAdmin}" />
                                    <MenuItem
                                        x:Name="menuSettingsSetUWP"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.TbSettingsSetUWP}" />
                                    <MenuItem
                                        x:Name="menuClearServerStatistics"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                    <MenuItem
                                        x:Name="menuCopyProxyCmd"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuCopyProxyCmdToClipboard}" />
                                    <MenuItem
                                        x:Name="menuOpenTheFileLocation"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                                    <MenuItem
                                        x:Name="menuPromotion"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="my.rockblack.tech" />
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    x:Name="menuCheckUpdate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuCheckUpdate}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon
                                            x:Name="iconCheckUpdate"
                                            Kind="Update"
                                            Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuHelp"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuHelp}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="HelpCircleOutline" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    x:Name="menuClose"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuClose}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="ChevronDoubleDown" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuExit"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuExit}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Power" Style="{StaticResource MenuIcon}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!--  new version badge  -->
                    <Ellipse
                        x:Name="dotNewUpdate"
                        Width="9"
                        Height="9"
                        Margin="0,6,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Fill="{DynamicResource RB.Primary}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                </Grid>

                <!--  wordmark  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="20"
                        Height="25"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/Resources/rockblack-symbol.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold">
                        <Run Foreground="{DynamicResource RB.Primary}" Text="Rock" /><Run Foreground="{DynamicResource RB.Text}" Text="Black" />
                    </TextBlock>
                    <Button
                        x:Name="btnNewUpdate"
                        Height="26"
                        Margin="12,0,0,0"
                        Padding="10,0"
                        Content="{x:Static resx:ResUI.menuNewUpdate}"
                        FontSize="12"
                        Foreground="{DynamicResource RB.Primary}"
                        Style="{StaticResource RB.ChipButton}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  add / import  -->
                <Button
                    x:Name="btnAdd"
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="{x:Static resx:ResUI.RbAdd}"
                    Style="{StaticResource RB.GhostButton}"
                    ToolTip="{x:Static resx:ResUI.RbAdd}">
                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        Kind="Plus" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="menuAdd" Style="{StaticResource DefContextMenu}">
                            <MenuItem
                                x:Name="menuAddServerViaClipboard"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                InputGestureText="Ctrl+V">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentPaste" Style="{StaticResource MenuIcon}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                x:Name="menuAddServerViaScan"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                InputGestureText="Ctrl+S">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="QrcodeScan" Style="{StaticResource MenuIcon}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                x:Name="menuAddServerViaImage"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.menuAddServerViaImage}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ImageOutline" Style="{StaticResource MenuIcon}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem
                                x:Name="menuAddSubscription"
                                Height="{StaticResource MenuItemHeight}"
                                Header="{x:Static resx:ResUI.RbAddSubscription}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="RssBox" Style="{StaticResource MenuIcon}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.RbAddManually}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ServerPlus" Style="{StaticResource MenuIcon}" />
                                </MenuItem.Icon>
                                <MenuItem
                                    x:Name="menuAddVlessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                <MenuItem
                                    x:Name="menuAddVmessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                <MenuItem
                                    x:Name="menuAddShadowsocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                <MenuItem
                                    x:Name="menuAddTrojanServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                <MenuItem
                                    x:Name="menuAddHysteria2Server"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                <MenuItem
                                    x:Name="menuAddTuicServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                <MenuItem
                                    x:Name="menuAddWireguardServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                <MenuItem
                                    x:Name="menuAddAnytlsServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                <MenuItem
                                    x:Name="menuAddNaiveServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                <MenuItem
                                    x:Name="menuAddMasqueServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                <MenuItem
                                    x:Name="menuAddSocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                <MenuItem
                                    x:Name="menuAddHttpServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                <Separator />
                                <MenuItem
                                    x:Name="menuAddCustomServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                <MenuItem
                                    x:Name="menuAddCustomOutboundServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                <MenuItem
                                    x:Name="menuAddPolicyGroupServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                <MenuItem
                                    x:Name="menuAddProxyChainServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!--  ===== Main screen  =====  -->
            <ContentControl
                x:Name="contentHome"
                Grid.Row="1"
                Focusable="False" />

            <!--  tray icon host (StatusBarView only carries the notify icon and its menu)  -->
            <ContentControl
                x:Name="contentStatusBarView"
                Grid.Row="1"
                Width="0"
                Height="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Focusable="False" />

            <materialDesign:Snackbar
                x:Name="MainSnackbar"
                Grid.Row="1"
                MessageQueue="{materialDesign:MessageQueue}" />
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
