<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="RockBlack"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/v2rayN.ico"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <Style x:Key="NavIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NavText" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style
                x:Key="RB.TabItem"
                BasedOn="{StaticResource MaterialDesignTabItem}"
                TargetType="{x:Type TabItem}">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="Custom" />
                <Setter Property="materialDesign:ColorZoneAssist.Foreground" Value="{DynamicResource RB.Primary}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        DialogBackground="{DynamicResource RB.Surface}"
        DialogContentUniformCornerRadius="16"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ===== Sidebar  =====  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource RB.Surface}"
                BorderBrush="{DynamicResource RB.Outline}"
                BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18,14,14">
                    <!--  logo + wordmark  -->
                    <StackPanel
                        Margin="6,0,0,22"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Image
                            Width="34"
                            Height="42"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Resources/rockblack-symbol.png" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="SemiBold">
                                <Run Foreground="{DynamicResource RB.Primary}" Text="Rock" /><Run Foreground="{DynamicResource RB.Text}" Text="Black" />
                            </TextBlock>
                            <TextBlock
                                Margin="1,-2,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource RB.TextMuted}"
                                Text="V P N" />
                        </StackPanel>
                    </StackPanel>

                    <!--  bottom actions  -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button
                            x:Name="btnNewUpdate"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            Content="{x:Static resx:ResUI.menuNewUpdate}"
                            Style="{StaticResource DefButton}"
                            Visibility="Hidden" />
                        <Border
                            Height="1"
                            Margin="4,0,4,8"
                            Background="{DynamicResource RB.Outline}" />
                        <Button
                            x:Name="menuReload"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuReload}"
                            Style="{StaticResource RB.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Reload" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.menuReload}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="menuPromotion"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuPromotion}"
                            Style="{StaticResource RB.NavButton}"
                            ToolTip="https://my.rockblack.tech">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Web" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="my.rockblack.tech" />
                            </StackPanel>
                        </Button>
                        <DockPanel Margin="0,4,0,0">
                            <materialDesign:PopupBox
                                Width="42"
                                Height="42"
                                Padding="-2"
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource RB.TextMuted}"
                                PlacementMode="RightAndAlignBottomEdges"
                                StaysOpen="True"
                                Style="{StaticResource MaterialDesignToolForegroundPopupBox}"
                                ToolTip="{x:Static resx:ResUI.TbSettingsTheme}">
                                <materialDesign:PopupBox.ToggleContent>
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Kind="PaletteOutline" />
                                </materialDesign:PopupBox.ToggleContent>
                                <ContentControl x:Name="pbTheme" />
                            </materialDesign:PopupBox>
                            <Button
                                x:Name="menuClose"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuClose}"
                                Style="{StaticResource RB.NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChevronDoubleDown" Style="{StaticResource NavIcon}" />
                                    <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.menuClose}" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>

                    <!--  navigation: every upstream top menu is kept, opened as a side menu  -->
                    <StackPanel>
                        <Button
                            x:Name="navServers"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuServers}"
                            Style="{StaticResource RB.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ServerNetwork" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.RbServers}" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource RB.NavMenu}">
                                    <MenuItem
                                        x:Name="menuAddServerViaClipboard"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                        InputGestureText="Ctrl+V" />
                                    <MenuItem
                                        x:Name="menuAddServerViaScan"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                        InputGestureText="Ctrl+S" />
                                    <MenuItem
                                        x:Name="menuAddServerViaImage"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="menuAddCustomServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                    <MenuItem
                                        x:Name="menuAddPolicyGroupServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                    <MenuItem
                                        x:Name="menuAddProxyChainServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                    <MenuItem
                                        x:Name="menuAddCustomOutboundServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="menuAddVmessServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                    <MenuItem
                                        x:Name="menuAddVlessServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                    <MenuItem
                                        x:Name="menuAddShadowsocksServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                    <MenuItem
                                        x:Name="menuAddTrojanServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                    <MenuItem
                                        x:Name="menuAddHysteria2Server"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                    <MenuItem
                                        x:Name="menuAddWireguardServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                    <MenuItem
                                        x:Name="menuAddMasqueServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                    <MenuItem
                                        x:Name="menuAddSocksServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                    <MenuItem
                                        x:Name="menuAddHttpServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="menuAddTuicServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                    <MenuItem
                                        x:Name="menuAddAnytlsServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                    <MenuItem
                                        x:Name="menuAddNaiveServer"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button
                            x:Name="navSubscriptions"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuSubscription}"
                            Style="{StaticResource RB.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RssBox" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.RbSubscriptions}" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource RB.NavMenu}">
                                    <MenuItem
                                        x:Name="menuSubSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubSetting}" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="menuSubUpdate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                    <MenuItem
                                        x:Name="menuSubUpdateViaProxy"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                    <MenuItem
                                        x:Name="menuSubGroupUpdate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                    <MenuItem
                                        x:Name="menuSubGroupUpdateViaProxy"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button
                            x:Name="navRouting"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuRoutingSetting}"
                            Style="{StaticResource RB.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CallSplit" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.menuRouting}" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="navSettings"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuSetting}"
                            Style="{StaticResource RB.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.menuSetting}" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource RB.NavMenu}">
                                    <MenuItem
                                        x:Name="menuOptionSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                    <MenuItem
                                        x:Name="menuRoutingSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                    <MenuItem
                                        x:Name="menuDNSSetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                    <MenuItem
                                        x:Name="menuFullConfigTemplate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                    <MenuItem
                                        x:Name="menuGlobalHotkeySetting"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="menuRebootAsAdmin"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRebootAsAdmin}" />
                                    <MenuItem
                                        x:Name="menuSettingsSetUWP"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.TbSettingsSetUWP}" />
                                    <MenuItem
                                        x:Name="menuClearServerStatistics"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                    <Separator />
                                    <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                        <MenuItem
                                            x:Name="menuRegionalPresetsDefault"
                                            Height="{StaticResource MenuItemHeight}"
                                            Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                        <MenuItem
                                            x:Name="menuRegionalPresetsRussia"
                                            Height="{StaticResource MenuItemHeight}"
                                            Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                        <MenuItem
                                            x:Name="menuRegionalPresetsIran"
                                            Height="{StaticResource MenuItemHeight}"
                                            Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                    </MenuItem>
                                    <MenuItem
                                        x:Name="menuBackupAndRestore"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                    <MenuItem
                                        x:Name="menuOpenTheFileLocation"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <ToggleButton
                            x:Name="navLogs"
                            AutomationProperties.Name="{x:Static resx:ResUI.RbLogs}"
                            IsChecked="True"
                            Style="{StaticResource RB.NavToggle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBoxOutline" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.RbLogs}" />
                            </StackPanel>
                        </ToggleButton>

                        <Button
                            x:Name="navHelp"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuHelp}"
                            Style="{StaticResource RB.NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Style="{StaticResource NavIcon}" />
                                <TextBlock Style="{StaticResource NavText}" Text="{x:Static resx:ResUI.menuHelp}" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="menuHelp" Style="{StaticResource RB.NavMenu}">
                                    <MenuItem
                                        x:Name="menuCheckUpdate"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                    <Separator />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  ===== Main area: status card, servers, logs  =====  -->
            <Grid Grid.Column="1" Margin="20,20,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="contentStatusBarView" Grid.Row="0" />

                <Grid Grid.Row="2">
                    <Grid x:Name="gridMain" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Padding="12"
                            Style="{StaticResource RB.Card}">
                            <ContentControl x:Name="tabProfiles" />
                        </Border>
                        <GridSplitter
                            x:Name="splitMain"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Background="Transparent" />
                        <Border
                            x:Name="cardLogs"
                            Grid.Column="2"
                            Padding="10,4,10,10"
                            Style="{StaticResource RB.Card}">
                            <DockPanel>
                                <StackPanel
                                    Margin="4,8,0,2"
                                    DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=tabMsgView}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource RB.Primary}"
                                        Kind="TextBoxOutline" />
                                    <TextBlock Style="{StaticResource RB.Section}" Text="{x:Static resx:ResUI.RbLogs}" />
                                </StackPanel>
                            <TabControl x:Name="tabMain" HorizontalContentAlignment="Left">
                                <TabItem
                                    x:Name="tabMsgView"
                                    Header="{x:Static resx:ResUI.RbLogs}"
                                    Style="{StaticResource RB.TabItem}" />
                                <TabItem
                                    x:Name="tabClashProxies"
                                    Header="{x:Static resx:ResUI.TbProxies}"
                                    Style="{StaticResource RB.TabItem}" />
                                <TabItem
                                    x:Name="tabClashConnections"
                                    Header="{x:Static resx:ResUI.TbConnections}"
                                    Style="{StaticResource RB.TabItem}" />
                            </TabControl>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="gridMain1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="12"
                            Style="{StaticResource RB.Card}">
                            <ContentControl x:Name="tabProfiles1" />
                        </Border>
                        <GridSplitter
                            x:Name="splitMain1"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Background="Transparent" />
                        <Border
                            x:Name="cardLogs1"
                            Grid.Row="2"
                            Padding="10,4,10,10"
                            Style="{StaticResource RB.Card}">
                            <DockPanel>
                                <StackPanel
                                    Margin="4,8,0,2"
                                    DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=tabMsgView1}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource RB.Primary}"
                                        Kind="TextBoxOutline" />
                                    <TextBlock Style="{StaticResource RB.Section}" Text="{x:Static resx:ResUI.RbLogs}" />
                                </StackPanel>
                            <TabControl x:Name="tabMain1" HorizontalContentAlignment="Left">
                                <TabItem x:Name="tabMsgView1" Style="{StaticResource RB.TabItem}">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="TextBoxOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.RbLogs}" />
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>
                                <TabItem x:Name="tabClashProxies1" Style="{StaticResource RB.TabItem}">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="ArrowDecisionOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbProxies}" />
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>
                                <TabItem x:Name="tabClashConnections1" Style="{StaticResource RB.TabItem}">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="LanConnect" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbConnections}" />
                                        </StackPanel>
                                    </TabItem.Header>
                                </TabItem>
                            </TabControl>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border
                        x:Name="gridMain2"
                        Padding="10,4,10,10"
                        Style="{StaticResource RB.Card}"
                        Visibility="Collapsed">
                        <TabControl x:Name="tabMain2" HorizontalContentAlignment="Left">
                            <TabItem x:Name="tabProfiles2" Style="{StaticResource RB.TabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="ServerNetwork" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.RbServers}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabMsgView2" Style="{StaticResource RB.TabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="TextBoxOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.RbLogs}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashProxies2" Style="{StaticResource RB.TabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="ArrowDecisionOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbProxies}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashConnections2" Style="{StaticResource RB.TabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="LanConnect" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbConnections}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </Border>
                    <materialDesign:Snackbar x:Name="MainSnackbar" MessageQueue="{materialDesign:MessageQueue}" />
                </Grid>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
