<UserControl
    x:Class="v2rayN.Desktop.Views.HomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Desktop.Converters"
    xmlns:ctl="clr-namespace:v2rayN.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="820"
    d:DesignWidth="460"
    x:DataType="vms:HomeViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <StreamGeometry x:Key="IconChevronUp">M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="IconSpeed">M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C14,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.07V20.07C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.07V20.07C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65V18.65C19.11,17.2 20,15.21 20,13C20,12 19.81,11 19.46,10.1L20.67,8C21.5,9.5 22,11.18 22,13Z</StreamGeometry>
        <StreamGeometry x:Key="IconLoading">M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z</StreamGeometry>
        <StreamGeometry x:Key="IconDots">M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z</StreamGeometry>
        <StreamGeometry x:Key="IconInfo">M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</StreamGeometry>
        <StreamGeometry x:Key="IconTelegram">M2,21L23,12L2,3V10L17,12L2,14V21Z</StreamGeometry>
        <StreamGeometry x:Key="IconLink">M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C7.22,12.88 7.22,9.71 9.17,7.76V7.76L12.71,4.22C14.66,2.27 17.83,2.27 19.78,4.22C21.73,6.17 21.73,9.34 19.78,11.29L18.29,12.78C18.3,11.96 18.17,11.14 17.89,10.36L18.36,9.88C19.54,8.71 19.54,6.81 18.36,5.64C17.19,4.46 15.29,4.46 14.12,5.64L10.59,9.17C9.41,10.34 9.41,12.24 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C16.78,11.12 16.78,14.29 14.83,16.24V16.24L11.29,19.78C9.34,21.73 6.17,21.73 4.22,19.78C2.27,17.83 2.27,14.66 4.22,12.71L5.71,11.22C5.7,12.04 5.83,12.86 6.11,13.65L5.64,14.12C4.46,15.29 4.46,17.19 5.64,18.36C6.81,19.54 8.71,19.54 9.88,18.36L13.41,14.83C14.59,13.66 14.59,11.76 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z</StreamGeometry>
        <StreamGeometry x:Key="IconWeb">M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M8,8H5.08C6.03,6.34 7.57,5.06 9.4,4.44C8.8,5.55 8.35,6.75 8,8M5.08,16H8C8.35,17.25 8.8,18.45 9.4,19.56C7.57,18.93 6.03,17.65 5.08,16M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14M12,4.03C12.83,5.23 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.23 12,4.03M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="IconRouting">M14,4L16.29,6.29L13.41,9.17L14.83,10.59L17.71,7.71L20,10V4M10,4H4V10L6.29,7.71L11,12.41V20H13V11.59L7.71,6.29</StreamGeometry>
        <StreamGeometry x:Key="IconMenuDown">M7,10L12,15L17,10H7Z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowDown">M11,4H13V16L18.5,10.5L19.92,11.92L12,19.84L4.08,11.92L5.5,10.5L11,16V4Z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowUp">M13,20H11V8L5.5,13.5L4.08,12.08L12,4.16L19.92,12.08L18.5,13.5L13,8V20Z</StreamGeometry>
        <StreamGeometry x:Key="IconMonitor">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z</StreamGeometry>
        <StreamGeometry x:Key="IconShield">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z</StreamGeometry>
        <StreamGeometry x:Key="IconAlert">M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="IconServerOff">M4,1H20A1,1 0 0,1 21,2V6A1,1 0 0,1 20,7H4A1,1 0 0,1 3,6V2A1,1 0 0,1 4,1M4,9H20A1,1 0 0,1 21,10V14A1,1 0 0,1 20,15H4A1,1 0 0,1 3,14V10A1,1 0 0,1 4,9M4,17H20A1,1 0 0,1 21,18V22A1,1 0 0,1 20,23H4A1,1 0 0,1 3,22V18A1,1 0 0,1 4,17M9,5H10V3H9V5M9,13H10V11H9V13M9,21H10V19H9V21M5,3V5H7V3H5M5,11V13H7V11H5M5,19V21H7V19H5Z</StreamGeometry>
    </UserControl.Resources>

    <Grid>
        <!--  narrow (Happ-like single column, centred, max 560 px)  -->
        <ScrollViewer x:Name="narrowScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="narrowHost"
                MaxWidth="560"
                Margin="16,0,16,8">

                <!--  ===== status: power button, state, timer, speed, chips =====  -->
                <StackPanel
                    x:Name="statusPanel"
                    Margin="0,4,0,20"
                    HorizontalAlignment="Center"
                    Spacing="0">
                    <Button
                        x:Name="btnPower"
                        HorizontalAlignment="Center"
                        Classes="rbPower"
                        Classes.connected="{Binding IsConnected}"
                        Classes.connecting="{Binding IsConnecting}"
                        Command="{Binding ToggleConnectCmd}"
                        ToolTip.Tip="{x:Static resx:ResUI.RbConnectTip}" />

                    <TextBlock
                        x:Name="txtState"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Classes.on="{Binding IsConnected}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        LetterSpacing="1.2"
                        Text="{Binding ConnectionStateText}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource RB.TextMuted}" />
                            </Style>
                            <Style Selector="TextBlock.on">
                                <Setter Property="Foreground" Value="{DynamicResource RB.Primary}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Classes="rbNumbers"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource RB.Text}"
                        IsVisible="{Binding IsConnected}"
                        Text="{Binding SessionTimeText}" />
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowSpeed}"
                        Orientation="Horizontal"
                        Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon
                                Width="13"
                                Height="13"
                                Data="{StaticResource IconArrowDown}"
                                Foreground="{DynamicResource RB.Primary}" />
                            <TextBlock
                                Classes="rbNumbers"
                                FontSize="13"
                                Foreground="{DynamicResource RB.TextMuted}"
                                Text="{Binding SpeedDownText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon
                                Width="13"
                                Height="13"
                                Data="{StaticResource IconArrowUp}"
                                Foreground="{DynamicResource RB.TextMuted}" />
                            <TextBlock
                                Classes="rbNumbers"
                                FontSize="13"
                                Foreground="{DynamicResource RB.TextMuted}"
                                Text="{Binding SpeedUpText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        MaxWidth="320"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Classes="rbCaption"
                        Text="{Binding ActiveServerName}" />

                    <!--  chips: routing profile + Proxy / TUN mode  -->
                    <WrapPanel
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        ItemSpacing="10"
                        LineSpacing="10">
                        <Button x:Name="btnRouting" Classes="rbChip">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconRouting}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding RoutingChipText}" />
                                <PathIcon
                                    Width="14"
                                    Height="14"
                                    Data="{StaticResource IconMenuDown}"
                                    Foreground="{DynamicResource RB.TextMuted}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Width="320" Spacing="2">
                                        <TextBlock
                                            Margin="12,4,12,6"
                                            Classes="rbCaption"
                                            Text="{x:Static resx:ResUI.RbRoutingProfiles}" />
                                        <ItemsControl ItemsSource="{Binding RoutingProfiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vms:RoutingProfileViewModel">
                                                    <Button
                                                        Classes="rbSheetItem"
                                                        Classes.active="{Binding IsActive}"
                                                        Click="RoutingItem_Click">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="14"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Classes="rbCaption"
                                                                    IsVisible="{Binding HasDescription}"
                                                                    Text="{Binding Description}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <PathIcon
                                                                Grid.Column="1"
                                                                Width="18"
                                                                Height="18"
                                                                Margin="8,0,0,0"
                                                                Data="{StaticResource IconCheck}"
                                                                Foreground="{DynamicResource RB.Primary}"
                                                                IsVisible="{Binding IsActive}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border
                                            Height="1"
                                            Margin="8,4"
                                            Background="{DynamicResource RB.Outline}" />
                                        <Button
                                            x:Name="btnRoutingSettings"
                                            Classes="rbSheetItem"
                                            Click="RoutingSettings_Click">
                                            <TextBlock Foreground="{DynamicResource RB.TextMuted}" Text="{x:Static resx:ResUI.RbRoutingSettingsMore}" />
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Border Classes="rbSegment">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button
                                    Classes="rbSegmentItem"
                                    Classes.active="{Binding IsProxyMode}"
                                    Command="{Binding SetProxyModeCmd}">
                                    <StackPanel Orientation="Horizontal">
                                        <PathIcon Data="{StaticResource IconMonitor}" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.RbModeProxy}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Classes="rbSegmentItem"
                                    Classes.active="{Binding IsTunMode}"
                                    Command="{Binding SetTunModeCmd}">
                                    <StackPanel Orientation="Horizontal">
                                        <PathIcon Data="{StaticResource IconShield}" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static resx:ResUI.RbModeTun}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!--  ===== subscription cards =====  -->
                <StackPanel x:Name="groupsPanel">
                    <Border
                        Padding="24,28"
                        Classes="rbGroup"
                        IsVisible="{Binding IsEmpty}">
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <PathIcon
                                Width="34"
                                Height="34"
                                Data="{StaticResource IconServerOff}"
                                Foreground="{DynamicResource RB.TextMuted}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Classes="rbSection"
                                Text="{x:Static resx:ResUI.RbEmptyTitle}" />
                            <TextBlock
                                MaxWidth="340"
                                HorizontalAlignment="Center"
                                Classes="rbCaption"
                                Text="{x:Static resx:ResUI.RbEmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Classes="Primary"
                                Command="{Binding AddSubscriptionCmd}"
                                Content="{x:Static resx:ResUI.RbAddSubscription}"
                                Theme="{DynamicResource SolidButton}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vms:ServerGroupViewModel">
                                <Border Classes="rbGroup">
                                    <StackPanel>
                                        <!--  header: collapse, name, updated · auto-update, refresh, ping, menu  -->
                                        <Border Classes="rbGroupHeader">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Button
                                                    VerticalAlignment="Center"
                                                    Classes="rbIcon small muted"
                                                    Command="{Binding ToggleExpandCmd}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconChevronUp}" IsVisible="{Binding IsExpanded}" />
                                                        <PathIcon Data="{StaticResource IconChevronDown}" IsVisible="{Binding !IsExpanded}" />
                                                    </Panel>
                                                </Button>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="6,0,8,0"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="17"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource RB.Text}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Classes="rbCaption"
                                                        IsVisible="{Binding HasSubtitle}"
                                                        Text="{Binding SubtitleText}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="rbIcon small"
                                                    Command="{Binding RefreshCmd}"
                                                    IsVisible="{Binding CanRefresh}"
                                                    ToolTip.Tip="{x:Static resx:ResUI.RbRefresh}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconRefresh}" IsVisible="{Binding !IsRefreshing}" />
                                                        <PathIcon
                                                            Classes="spin"
                                                            Data="{StaticResource IconLoading}"
                                                            IsVisible="{Binding IsRefreshing}" />
                                                    </Panel>
                                                </Button>
                                                <Button
                                                    Grid.Column="3"
                                                    Classes="rbIcon small"
                                                    Command="{Binding PingCmd}"
                                                    ToolTip.Tip="{x:Static resx:ResUI.RbPing}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconSpeed}" IsVisible="{Binding !IsPinging}" />
                                                        <PathIcon
                                                            Classes="spin"
                                                            Data="{StaticResource IconLoading}"
                                                            IsVisible="{Binding IsPinging}" />
                                                    </Panel>
                                                </Button>
                                                <Button
                                                    Grid.Column="4"
                                                    Classes="rbIcon small"
                                                    ToolTip.Tip="{x:Static resx:ResUI.RbMore}">
                                                    <PathIcon Data="{StaticResource IconDots}" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem
                                                                Command="{Binding SortByPingCmd}"
                                                                Header="{x:Static resx:ResUI.RbSortByPing}"
                                                                IsChecked="{Binding SortMode, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Ping}"
                                                                ToggleType="CheckBox" />
                                                            <MenuItem
                                                                Command="{Binding SortByNameCmd}"
                                                                Header="{x:Static resx:ResUI.RbSortByName}"
                                                                IsChecked="{Binding SortMode, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Name}"
                                                                ToggleType="CheckBox" />
                                                            <MenuItem
                                                                Command="{Binding SortDefaultCmd}"
                                                                Header="{x:Static resx:ResUI.RbSortDefault}"
                                                                IsChecked="{Binding SortMode, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Default}"
                                                                ToggleType="CheckBox" />
                                                            <Separator />
                                                            <MenuItem Command="{Binding SelectFastestCmd}" Header="{x:Static resx:ResUI.RbSelectFastest}" />
                                                            <MenuItem Command="{Binding PingCmd}" Header="{x:Static resx:ResUI.RbPingAll}" />
                                                            <MenuItem
                                                                Command="{Binding RefreshCmd}"
                                                                Header="{x:Static resx:ResUI.RbRefresh}"
                                                                IsVisible="{Binding CanRefresh}" />
                                                            <Separator IsVisible="{Binding !IsManual}" />
                                                            <MenuItem
                                                                Command="{Binding OpenSupportCmd}"
                                                                Header="{x:Static resx:ResUI.RbSupport}"
                                                                IsVisible="{Binding HasSupportUrl}" />
                                                            <MenuItem
                                                                Command="{Binding OpenWebPageCmd}"
                                                                Header="{x:Static resx:ResUI.RbWebsite}"
                                                                IsVisible="{Binding HasWebPageUrl}" />
                                                            <MenuItem
                                                                Command="{Binding EditCmd}"
                                                                Header="{x:Static resx:ResUI.RbEditSubscription}"
                                                                IsVisible="{Binding !IsManual}" />
                                                            <MenuItem
                                                                Command="{Binding DeleteCmd}"
                                                                Header="{x:Static resx:ResUI.RbDeleteSubscription}"
                                                                IsVisible="{Binding !IsManual}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!--  expiry banner  -->
                                        <Border
                                            Padding="14,10"
                                            Background="{DynamicResource RB.Danger}"
                                            IsVisible="{Binding ShowExpiryBanner}">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding ExpiryBannerText}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    MinWidth="150"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    Background="#2EFFFFFF"
                                                    BorderBrush="#B3FFFFFF"
                                                    Classes="rbChip"
                                                    Command="{Binding OpenWebPageCmd}"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    IsVisible="{Binding HasWebPageUrl}">
                                                    <TextBlock Text="{x:Static resx:ResUI.RbRenew}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!--  info bar: traffic, expiry, support / website  -->
                                        <Border Classes="rbInfoBar" IsVisible="{Binding HasInfo}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <PathIcon
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,10,0"
                                                    Data="{StaticResource IconInfo}"
                                                    Foreground="{DynamicResource RB.Primary}" />
                                                <Panel
                                                    Grid.Column="1"
                                                    MinWidth="90"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding HasTraffic}">
                                                    <Border Classes="rbPill">
                                                        <ProgressBar
                                                            Classes="rbTraffic"
                                                            IsVisible="{Binding HasTrafficLimit}"
                                                            Value="{Binding TrafficPercent}" />
                                                    </Border>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Classes="rbNumbers"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource RB.Text}"
                                                        Text="{Binding TrafficText}" />
                                                </Panel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="12,0,4,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource RB.Text}"
                                                    IsVisible="{Binding HasExpiry}"
                                                    Text="{Binding ExpiryText}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Classes="rbIcon small"
                                                    Command="{Binding OpenSupportCmd}"
                                                    Foreground="{DynamicResource RB.Primary}"
                                                    IsVisible="{Binding HasSupportUrl}"
                                                    ToolTip.Tip="{x:Static resx:ResUI.RbSupport}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconTelegram}" IsVisible="{Binding IsTelegramSupport}" />
                                                        <PathIcon Data="{StaticResource IconLink}" IsVisible="{Binding !IsTelegramSupport}" />
                                                    </Panel>
                                                </Button>
                                                <Button
                                                    Grid.Column="4"
                                                    Classes="rbIcon small"
                                                    Command="{Binding OpenWebPageCmd}"
                                                    Foreground="{DynamicResource RB.Primary}"
                                                    IsVisible="{Binding HasWebPageUrl}"
                                                    ToolTip.Tip="{x:Static resx:ResUI.RbWebsite}">
                                                    <PathIcon Data="{StaticResource IconWeb}" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!--  announce  -->
                                        <Border
                                            Padding="14,8"
                                            Background="{DynamicResource RB.Surface2}"
                                            BorderBrush="{DynamicResource RB.Outline}"
                                            BorderThickness="0,1,0,0"
                                            IsVisible="{Binding HasAnnounce}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource RB.Text}"
                                                Text="{Binding Announce}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </Border>

                                        <!--  servers  -->
                                        <ItemsControl IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Servers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vms:ServerItemViewModel">
                                                    <Border BorderBrush="{DynamicResource RB.Outline}" BorderThickness="0,1,0,0">
                                                        <Button
                                                            Classes="rbRow"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Command="{Binding SelectCmd}">
                                                            <Button.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Command="{Binding SelectCmd}" Header="{x:Static resx:ResUI.RbSelect}" />
                                                                    <MenuItem Command="{Binding PingCmd}" Header="{x:Static resx:ResUI.RbPing}" />
                                                                    <Separator />
                                                                    <MenuItem Command="{Binding EditCmd}" Header="{x:Static resx:ResUI.RbEdit}" />
                                                                    <MenuItem Command="{Binding ShareCmd}" Header="{x:Static resx:ResUI.RbShareQr}" />
                                                                    <MenuItem Command="{Binding CopyLinkCmd}" Header="{x:Static resx:ResUI.RbCopyLink}" />
                                                                    <Separator />
                                                                    <MenuItem Command="{Binding DeleteCmd}" Header="{x:Static resx:ResUI.RbDelete}" />
                                                                </MenuFlyout>
                                                            </Button.ContextFlyout>
                                                            <Grid ColumnDefinitions="3,13,28,14,*,Auto,Auto">
                                                                <Border
                                                                    Grid.Column="0"
                                                                    Background="{DynamicResource RB.Primary}"
                                                                    IsVisible="{Binding IsSelected}" />
                                                                <ctl:FlagBadge
                                                                    Grid.Column="2"
                                                                    Width="28"
                                                                    Height="28"
                                                                    VerticalAlignment="Center"
                                                                    CountryCode="{Binding CountryCode}" />
                                                                <StackPanel
                                                                    Grid.Column="4"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="1">
                                                                    <TextBlock Classes="rbRowTitle" Text="{Binding Name}" />
                                                                    <TextBlock Classes="rbRowSubtitle" Text="{Binding Subtitle}" />
                                                                </StackPanel>
                                                                <Panel Grid.Column="5" Margin="10,0,2,0">
                                                                    <TextBlock
                                                                        Classes="rbDelay"
                                                                        Classes.bad="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Bad}"
                                                                        Classes.good="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Good}"
                                                                        Classes.timeout="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Timeout}"
                                                                        Classes.warning="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Warning}"
                                                                        IsVisible="{ReflectionBinding !$parent[UserControl].DataContext.PingShowIcon}"
                                                                        Text="{Binding DelayText}" />
                                                                    <Ellipse
                                                                        VerticalAlignment="Center"
                                                                        Classes="rbDelayDot"
                                                                        Classes.bad="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Bad}"
                                                                        Classes.good="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Good}"
                                                                        Classes.timeout="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Timeout}"
                                                                        Classes.warning="{Binding DelayState, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Warning}"
                                                                        IsVisible="{ReflectionBinding $parent[UserControl].DataContext.PingShowIcon}"
                                                                        ToolTip.Tip="{Binding DelayText}" />
                                                                </Panel>
                                                                <Button
                                                                    Grid.Column="6"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    Classes="rbIcon small muted"
                                                                    ToolTip.Tip="{x:Static resx:ResUI.RbServerActions}">
                                                                    <PathIcon Data="{StaticResource IconChevronRight}" />
                                                                    <Button.Flyout>
                                                                        <MenuFlyout Placement="LeftEdgeAlignedTop">
                                                                            <MenuItem Command="{Binding SelectCmd}" Header="{x:Static resx:ResUI.RbSelect}" />
                                                                            <MenuItem Command="{Binding PingCmd}" Header="{x:Static resx:ResUI.RbPing}" />
                                                                            <Separator />
                                                                            <MenuItem Command="{Binding EditCmd}" Header="{x:Static resx:ResUI.RbEdit}" />
                                                                            <MenuItem Command="{Binding ShareCmd}" Header="{x:Static resx:ResUI.RbShareQr}" />
                                                                            <MenuItem Command="{Binding CopyLinkCmd}" Header="{x:Static resx:ResUI.RbCopyLink}" />
                                                                            <Separator />
                                                                            <MenuItem Command="{Binding DeleteCmd}" Header="{x:Static resx:ResUI.RbDelete}" />
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  wide (two panes: status left, cards right)  -->
        <Grid
            x:Name="wideGrid"
            ColumnDefinitions="470,*"
            IsVisible="False">
            <Border
                x:Name="wideLeft"
                Grid.Column="0"
                Padding="16"
                VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    x:Name="wideRight"
                    MaxWidth="640"
                    Margin="8,4,24,8" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
