#
# The configuration file itself is not modified; mixing happens in memory only.
#
# Mind the indentation below; open this file in an editor with YAML support.
#
# Top-level Clash configuration keys used here override the original configuration.
#
# removed-rules    each entry is matched against every line of the rules array; matching lines are removed (put this key first)
#
# append-rules    array appended after the original rules array
# prepend-rules   array inserted before the original rules array
# append-proxies      array appended after the original proxies array
# prepend-proxies     array inserted before the original proxies array
# append-proxy-groups     array appended after the original proxy-groups array
# prepend-proxy-groups    array inserted before the original proxy-groups array
# append-rule-providers     array appended after the original rule-providers array
# prepend-rule-providers    array inserted before the original rule-providers array
#

dns:
  enable: true
  enhanced-mode: fake-ip
  nameserver:
    - 77.88.8.8
    - 8.8.8.8
  fallback: []
  fake-ip-filter:
    - +.stun.*.*
    - +.stun.*.*.*
    - +.stun.*.*.*.*
    - +.stun.*.*.*.*.*
    - "*.n.n.srv.nintendo.net"
    - +.stun.playstation.net
    - xbox.*.*.microsoft.com
    - "*.*.xboxlive.com"
    - "*.msftncsi.com"
    - "*.msftconnecttest.com"
    - WORKGROUP